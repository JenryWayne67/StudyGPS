# StudyGPS Environment Configuration
PORT=3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
SESSION_SECRET=studygps_super_secret_session_key
APP_URL=

# Optional: email notifications (schedule reminders, Settings > Send Test
# Email). Leave all of these blank and the feature just stays off - no
# crash, no error, users simply can't turn the toggle "on" successfully
# yet. Any SMTP provider works (Gmail with an App Password, SendGrid,
# Mailgun, your school/work SMTP relay, etc.) - fill in its host/port/
# credentials here. Requires `npm install` to be run once after pulling
# this change, so nodemailer (added to package.json) is actually installed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional - defaults to SMTP_USER if not set
SMTP_FROM=

