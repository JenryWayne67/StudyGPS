# StudyGPS Environment Configuration
PORT=3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
SESSION_SECRET=studygps_super_secret_session_key
APP_URL=

# Turso (hosted SQLite) - the real, persistent database. Leave both blank
# for local dev: the app falls back to a local SQLite file at
# database/studygps.db automatically. Set both once you have a Turso
# database (see README/DEPLOYMENT notes) so the app on Render points at
# the same persistent database instead of Render's ephemeral disk.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

